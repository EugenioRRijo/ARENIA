    "/computos/{dominio}": {
      "post": {
        "tags": [
          "computos"
        ],
        "summary": "Computar",
        "description": "Extrae las cantidades de obra de la fuente subida con el adaptador del dominio pedido.\n\n`codigos` es un JSON de texto (form field) con el mapeo que exige el adaptador civil; el resto\nde los dominios no lo necesita. El archivo se guarda en un directorio temporal con su nombre\noriginal, porque los adaptadores leen por extensión.",
        "operationId": "computar_computos__dominio__post",
        "parameters": [
          {
            "name": "dominio",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Dominio"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_computar_computos__dominio__post"
              }
            }
          }
        },
