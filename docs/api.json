    "/presupuestos/{codigo}": {
      "get": {
        "tags": [
          "presupuestos"
        ],
        "summary": "Obtener Presupuesto",
        "description": "El presupuesto reconstruido desde el catálogo (`cargar_presupuesto`), con sus renglones.\n\n`codigo` es único solo por proyecto: si dos proyectos comparten código, indique `proyecto`\npara desambiguar (`_buscar_modelo` responde 409 en vez de una ambigüedad silenciosa).",
        "operationId": "obtener_presupuesto_presupuestos__codigo__get",
        "parameters": [
          {
            "name": "codigo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Codigo"
